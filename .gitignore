# swift
swift-capture/.build/
*.xcuserstate
.swiftpm/

# app bundle produced by scripts/make_app_bundle.sh
build/

# python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# your own recordings stay local; data/samples/ is checked in on purpose, so
# everyone can replay real hardware data without owning the hardware
data/*.jsonl
!data/samples/*.jsonl

# captured pose references are personal: they depend on your body, your device
# placement and your calibration, so they do not transfer between people
data/asanas.json

# macos
.DS_Store
